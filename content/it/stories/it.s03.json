  {
   "speaker": null,
   "it": "[Giulia|name] [prende|it.v.prendere:pres.3sg] [le|it.art.le] [chiavi|it.n.chiave:pl] [e|it.conj.e] [dà|it.v.dare:pres.3sg] [le|it.art.le] [chiavi|it.n.chiave:pl] [a|it.prep.a] [Marco|name].",
   "en": "Giulia takes the keys and gives the keys to Marco."
